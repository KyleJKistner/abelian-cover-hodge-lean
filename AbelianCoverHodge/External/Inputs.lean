module

public import AbelianCoverHodge.Verified.AokiFusion

/-!
# Auditable interfaces for published inputs

This module contains **types of assumptions**, not proofs of the cited
theorems.  In particular, it declares no global postulate and constructs no value of any
input structure below.  A later module may take values of these structures as
explicit parameters, or an independently audited library may construct them.

The project is currently `Std`-only.  `Std` has no definitions of variations
of Hodge structure, algebraic groups, Chow groups, admissible covers, or
cohomological realizations.  The interfaces below therefore follow a strict
two-level convention:

* finite residue data and the hypotheses that can already be expressed in
  Lean are concrete;
* unavailable geometric objects are carrier types, while their mathematical
  properties are named predicates supplied by a context.

This erasure is deliberate and visible in every context name.  A predicate
such as `IsSmoothProper` is not evidence: evidence occurs only in the
corresponding published-input structure.  Replacing an erased context by
mathlib definitions must preserve the theorem signatures, not merely their
names.

The interfaces also keep source results separate from manuscript-specific
bridges.  Examples of bridges which are *not* fields below include:

* positivity of Chevalley--Weil multiplicities implies the Menet--Nguyen
  `good sequence` condition;
* a zero-signature determinant word gives an Aoki-balanced tuple;
* the pairing forest produces the precise balanced admissible cover;
* the fused branch tuple is simple and has the required rank;
* for a prime cyclic cover of `P^1`, Schoen's primitive factor is the whole
  Jacobian;
* determinant and cycle classes commute with the concrete identifications
  used in fusion.

Those are project obligations and must be proved in project modules.
-/

namespace AbelianCoverHodge.External

public section

@[expose] section

open AbelianCoverHodge.Verified

/-- Concrete primality predicate for the current `Std`-only layer.  This can
be replaced by the library primality predicate when the project adopts its
number-theory dependency. -/
abbrev IsPrime := IsPrimeModulus

/-! ## Audit metadata -/

/-- Human-readable source scope.  This is audit metadata only; it is never
used as mathematical evidence. -/
structure SourceScope where
  work : String
  locator : String
  importedConclusion : String

namespace Sources

def chevalleyWeil : SourceScope where
  work := "Chevalley--Weil formula for a cyclic cover of the projective line"
  locator := "the exact formula quoted as (CW) in the Phase I/II manuscripts"
  importedConclusion :=
    "the two eigenspace multiplicities and their cyclotomic rank"

def deligneFixedPart : SourceScope where
  work := "P. Deligne, Theorie de Hodge II"
  locator := "semisimplicity and the theorem of the fixed part"
  importedConclusion :=
    "semisimple connected monodromy and constancy of the invariant part"

def menetNguyenProjection : SourceScope where
  work :=
    "G. Menet and D.-M. Nguyen, Representations of braid groups via cyclic covers of the sphere"
  locator := "Definition 1.1(a) and Theorem 5.1 (source version to be pinned)"
  importedConclusion :=
    "full connected special-unitary projection for a primitive good sequence"

def andreNormality : SourceScope where
  work :=
    "Y. Andre, Mumford--Tate groups of mixed Hodge structures and the theorem of the fixed part"
  locator := "normality theorem used in Phase I"
  importedConclusion :=
    "connected monodromy is contained in the derived generic Hodge group"

def weylFFT : SourceScope where
  work := "H. Weyl, The Classical Groups"
  locator := "first fundamental theorem for special linear groups"
  importedConclusion :=
    "standard/dual invariants are generated by evaluations and volume tensors"

def aokiPrime : SourceScope where
  work :=
    "N. Aoki, On some arithmetic problems related to the Hodge cycles on the Fermat varieties"
  locator :=
    "prime-exponent balanced-tuple theorem, in the form used by Schoen near Corollary 1.9"
  importedConclusion :=
    "a balanced nonzero residue tuple has opposite multiplicities"

def acvSmoothing : SourceScope where
  work :=
    "D. Abramovich, A. Corti, and A. Vistoli, Twisted bundles and admissible covers"
  locator :=
    "balanced twisted-cover/admissible-cover deformation result; exact theorem number still to pin"
  importedConclusion :=
    "a tame balanced cyclic admissible cover has a simultaneous smoothing after finite base change"

def schoenSimpleTuple : SourceScope where
  work :=
    "C. Schoen, Hodge classes on self-products of a variety with an automorphism"
  locator := "Theorem 2.0 and Corollary 3.1"
  importedConclusion :=
    "algebraicity of the primitive cyclotomic determinant space for a simple tuple"

def compactTypePicard : SourceScope where
  work := "standard compact-type Picard theory"
  locator := "exact library/source theorem still to pin"
  importedConclusion :=
    "the identity component of the relative Picard functor is an abelian scheme"

def smoothProperComparison : SourceScope where
  work := "smooth proper base change"
  locator := "exact Betti/etale comparison package still to pin"
  importedConclusion :=
    "generic and special H1 are compatibly identified"

def chowSpecialization : SourceScope where
  work := "Fulton, Intersection Theory; SGA 6"
  locator := "specialization of Chow groups and compatibility with cycle classes"
  importedConclusion :=
    "specialization preserves codimension and commutes with realization"

def weightOneRealization : SourceScope where
  work := "standard weight-one Hodge theory of complex abelian varieties"
  locator :=
    "exterior-algebra realization, Poincare correspondences, and algebraic alternating projectors"
  importedConclusion :=
    "algebraic tensor generators give algebraic Hodge classes on all powers"

end Sources

/-! ## Concrete cyclic residue data -/

/-- Every entry of a cyclic branch tuple is nonzero.  Tuples in this module
list only actual branch occurrences, rather than padding by zero coordinates
of a larger branch code. -/
abbrev AllEntriesNonzero {p : Nat} [NeZero p] (word : BranchWord p) : Prop :=
  AllResiduesNonzero word

/-- Aoki balance at every nonzero Galois row, in the division-free form
`2 * sum [a beta_i]_p = p * length(beta)`. -/
abbrev IsAokiBalanced {p : Nat} [NeZero p] (word : BranchWord p) : Prop :=
  Verified.IsAokiBalanced p word

/-- The concrete input and output data on which Chevalley--Weil is used.  The
function `h10 a` denotes the `(1,0)` multiplicity at the embedding indexed by
`a`; only nonzero `a` are mathematically relevant. -/
structure CyclicHodgeDatum (p : Nat) [NeZero p] where
  branch : BranchWord p
  h10 : ZMod p → Nat
  cyclotomicRank : Nat

/-- The geometric hypotheses of the cyclic `P^1` form used in the
manuscripts.  For prime `p`, nonempty nonzero local monodromy already makes
the cyclic character faithful; this elementary implication is intentionally
not asserted here. -/
structure ChevalleyWeilHypotheses {p : Nat} [NeZero p]
    (datum : CyclicHodgeDatum p) : Prop where
  prime : IsPrime p
  branchSumZero : isBranchWord datum.branch
  entriesNonzero : AllEntriesNonzero datum.branch
  nonempty : 0 < llength datum.branch

/-- Exact Chevalley--Weil formulas used by the direct route.  This is a
parameter type.  It has no constructor in this repository. -/
structure ChevalleyWeilInput : Prop where
  formula :
    forall (p : Nat) [NeZero p] (datum : CyclicHodgeDatum p),
      ChevalleyWeilHypotheses datum →
      forall a : ZMod p, a ≠ zzero p →
        datum.h10 a =
            supportSize datum.branch - qValue a datum.branch - 1 ∧
        datum.h10 (zneg a) = qValue a datum.branch - 1 ∧
        datum.cyclotomicRank = supportSize datum.branch - 2

/-! ## Fixed part, full cyclic projection, and normality -/

/-- Erased vocabulary for the two Deligne conclusions actually used by Phase
I.  None of the proposition-valued fields is assumed merely by constructing
this context. -/
structure VariationContext where
  Variation : Type
  Subvariation : Type
  total : Variation
  fixedPart : Subvariation
  ConnectedMonodromySemisimple : Prop
  MonodromyInvariant : Subvariation → Prop
  Constant : Subvariation → Prop
  IsFullInvariantPart : Subvariation → Prop

/-- Deligne semisimplicity/fixed-part input at the exact level consumed by the
manuscript. -/
structure DeligneSemisimplicityFixedPartInput
    (context : VariationContext) : Prop where
  semisimple : context.ConnectedMonodromySemisimple
  fixedPartInvariant : context.MonodromyInvariant context.fixedPart
  fixedPartConstant : context.Constant context.fixedPart
  fixedPartIsFullInvariant : context.IsFullInvariantPart context.fixedPart

/-- Erased source vocabulary for the cyclic full-projection theorem.  In
particular, `GoodSequence` is to be replaced by the source's exact Definition
1.1(a), and `ConnectedProjectionIsFullSU` by an equality of algebraic groups
once those objects are available. -/
structure CyclicProjectionContext (p : Nat) [NeZero p] where
  Factor : Type
  datum : Factor → CyclicHodgeDatum p
  EffectiveCharacter : Factor → Prop
  PrimitiveCharacter : Factor → Prop
  GoodSequence : Factor → Prop
  ConnectedProjectionIsFullSU : Factor → Prop

/-- Menet--Nguyen's full cyclic projection is deliberately stated with its
source hypothesis `GoodSequence`, not with the manuscript's positivity
criterion.  Positivity-to-good-sequence is therefore forced to remain a
separate local proof. -/
structure MenetNguyenFullProjectionInput {p : Nat} [NeZero p]
    (context : CyclicProjectionContext p) : Prop where
  theorem5_1 :
    forall factor : context.Factor,
      context.EffectiveCharacter factor →
      context.PrimitiveCharacter factor →
      context.GoodSequence factor →
      context.ConnectedProjectionIsFullSU factor

/-- Explicit type of the manuscript-specific hypothesis match which must be
proved before `MenetNguyenFullProjectionInput` can be applied.  This structure
is not part of `PublishedInputs`. -/
structure PositivityMatchesGoodSequence {p : Nat} [NeZero p]
    (context : CyclicProjectionContext p) : Prop where
  ofPositive :
    forall factor : context.Factor,
      0 < (context.datum factor).h10 (zOfNat p 1) →
      0 < (context.datum factor).h10 (zneg (zOfNat p 1)) →
      context.GoodSequence factor

/-- Erased vocabulary for Andre normality. -/
structure NormalityContext where
  ConnectedMonodromy : Type
  DerivedGenericHodgeGroup : Type
  monodromy : ConnectedMonodromy
  derivedHodgeGroup : DerivedGenericHodgeGroup
  MonodromyContainedInDerivedHodge : Prop

/-- The exact normality consequence used in the Phase I sandwich argument. -/
structure AndreNormalityInput (context : NormalityContext) : Prop where
  normality : context.MonodromyContainedInDerivedHodge

/-! ## Weyl's standard/dual invariant theorem -/

inductive Variance where
  | standard
  | dual
deriving DecidableEq

/-- A concrete tensor shape; positions matter, since the final tensor category
also uses permutations. -/
structure MixedTensorShape where
  slots : List Variance

/-- Erased linear-algebra vocabulary for a standard/dual `SL_h` block.
`Expression` stands for a linear combination of tensor diagrams, and
`UsesOnlyEvaluationsAndVolumes` restricts its atoms to evaluation pairings and
the two `h`-fold volume tensors. -/
structure StandardDualFFTContext where
  Block : Type
  rank : Block → Nat
  IsSpecialLinearStandardDualBlock : Block → Prop
  Invariant : Block → MixedTensorShape → Type
  Expression : Block → MixedTensorShape → Type
  UsesOnlyEvaluationsAndVolumes :
    {block : Block} → {shape : MixedTensorShape} →
      Expression block shape → Prop
  realizes :
    {block : Block} → {shape : MixedTensorShape} →
      Expression block shape → Invariant block shape

/-- Surjective diagrammatic form of the first fundamental theorem for a
special-linear block acting on standards and duals. -/
structure WeylStandardDualFFTInput
    (context : StandardDualFFTContext) : Prop where
  generated :
    forall (block : context.Block) (shape : MixedTensorShape),
      context.IsSpecialLinearStandardDualBlock block →
      forall invariant : context.Invariant block shape,
        Exists fun expression : context.Expression block shape =>
          context.UsesOnlyEvaluationsAndVolumes expression ∧
          context.realizes expression = invariant

/-! ## Aoki's prime balanced-tuple theorem -/

/-- Concrete, source-auditable form of the only Aoki implication used by the
direct route.  The conclusion says exactly that every residue and its negative
have equal multiplicity. -/
structure AokiPrimeBalanceInput where
  balancedHasOppositePairing :
    forall (p : Nat) [NeZero p], IsPrime p →
      forall residues : BranchWord p,
        AllEntriesNonzero residues →
        IsAokiBalanced residues →
        OppositePairingWitness residues

/-! ## ACV balanced smoothing -/

/-- Erased moduli vocabulary for the scoped ACV consequence.  Notice that the
context does not assert that an admissible cover constructed by this project
is balanced, nor what its generic branch tuple is. -/
structure ACVSmoothingContext (p : Nat) [NeZero p] where
  AdmissibleCover : Type
  OneParameterFamily : Type
  IsConnectedDegreePCyclicCover : AdmissibleCover → Prop
  IsTame : AdmissibleCover → Prop
  IsBalancedAtEveryNode : AdmissibleCover → Prop
  TargetIsStableGenusZeroTree : AdmissibleCover → Prop
  IsSimultaneousSmoothingAfterFiniteBaseChange :
    OneParameterFamily → AdmissibleCover → Prop
  GenericFibreIsSmoothCyclicCoverOfP1 : OneParameterFamily → Prop

/-- ACV deformation input, with all hypotheses that the fusion construction
must discharge exposed in the type. -/
structure ACVBalancedSmoothingInput {p : Nat} [NeZero p]
    (context : ACVSmoothingContext p) : Prop where
  smooth :
    forall cover : context.AdmissibleCover,
      context.IsConnectedDegreePCyclicCover cover →
      context.IsTame cover →
      context.IsBalancedAtEveryNode cover →
      context.TargetIsStableGenusZeroTree cover →
      Exists fun family : context.OneParameterFamily =>
        context.IsSimultaneousSmoothingAfterFiniteBaseChange family cover ∧
        context.GenericFibreIsSmoothCyclicCoverOfP1 family

/-! ## Schoen's primitive simple-tuple cycles -/

/-- Erased cycle/realization vocabulary for Schoen's theorem.  A value of
`PrimitiveCycleCombination` represents a rational linear combination of
cycles on the primitive abelian factor.  Indexing it by codimension makes
codimension preservation part of the type. -/
structure SchoenContext (p : Nat) [NeZero p] where
  CyclicCover : Type
  branchTuple : CyclicCover → BranchWord p
  cyclotomicRank : CyclicCover → Nat
  IsDegreePCoverOfP1 : CyclicCover → Prop
  IsPrimitiveCyclotomicFactor : CyclicCover → Prop
  PrimitiveDeterminantClass : CyclicCover → Type
  PrimitiveCycleCombination : CyclicCover → Nat → Type
  cycleClass :
    {cover : CyclicCover} → {codimension : Nat} →
      PrimitiveCycleCombination cover codimension →
      PrimitiveDeterminantClass cover

/-- Schoen's imported conclusion stops at the primitive cyclotomic abelian
factor.  The project must separately prove that this factor is the whole
Jacobian in the prime cyclic `P^1` case where that is used. -/
structure SchoenSimpleTupleInput {p : Nat} [NeZero p]
    (context : SchoenContext p) : Prop where
  primitiveDeterminantAlgebraic :
    IsPrime p →
    forall cover : context.CyclicCover,
      context.IsDegreePCoverOfP1 cover →
      context.IsPrimitiveCyclotomicFactor cover →
      AllEntriesNonzero (context.branchTuple cover) →
      hasOppositeMultiplicities (context.branchTuple cover) →
      context.cyclotomicRank cover % 2 = 0 →
      forall determinant : context.PrimitiveDeterminantClass cover,
        Exists fun cycle :
            context.PrimitiveCycleCombination cover
              (context.cyclotomicRank cover / 2) =>
          context.cycleClass cycle = determinant

/-! ## Compact type, smooth proper comparison, and Chow specialization -/

/-- A small equivalence type, used because this project intentionally does
not yet depend on mathlib's linear equivalences. -/
structure TypeEquivalence (alpha beta : Type) where
  toFun : alpha → beta
  invFun : beta → alpha
  leftInverse : forall x, invFun (toFun x) = x
  rightInverse : forall y, toFun (invFun y) = y

/-- Erased relative-Picard vocabulary. -/
structure CompactTypePicardContext where
  CurveFamily : Type
  RelativePicard : Type
  IsOneParameterNodalSmoothing : CurveFamily → Prop
  SpecialFibreIsCompactType : CurveFamily → Prop
  IsIdentityComponentOfRelativePicard :
    RelativePicard → CurveFamily → Prop
  IsAbelianScheme : RelativePicard → Prop
  GenericFibreIsJacobian : RelativePicard → CurveFamily → Prop
  SpecialFibreIsProductOfComponentJacobians :
    RelativePicard → CurveFamily → Prop

/-- Standard compact-type Picard input used to put generic and special
Jacobians in one abelian scheme. -/
structure CompactTypePicardInput
    (context : CompactTypePicardContext) : Prop where
  relativePicard :
    forall family : context.CurveFamily,
      context.IsOneParameterNodalSmoothing family →
      context.SpecialFibreIsCompactType family →
      Exists fun picard : context.RelativePicard =>
        context.IsIdentityComponentOfRelativePicard picard family ∧
        context.IsAbelianScheme picard ∧
        context.GenericFibreIsJacobian picard family ∧
        context.SpecialFibreIsProductOfComponentJacobians picard family

/-- Erased smooth-proper `H1` vocabulary.  `CyclotomicLinear` records the
compatibility with the deck/cyclotomic action needed by determinant spaces. -/
structure SmoothProperComparisonContext where
  Family : Type
  GenericH1 : Family → Type
  SpecialH1 : Family → Type
  IsSmoothProper : Family → Prop
  CyclotomicLinear :
    {family : Family} →
      (GenericH1 family → SpecialH1 family) → Prop

/-- Smooth proper comparison as an actual equivalence of the erased `H1`
carriers, plus the equivariance used in the proof. -/
structure SmoothProperComparisonInput
    (context : SmoothProperComparisonContext) : Prop where
  comparison :
    forall family : context.Family, context.IsSmoothProper family →
      Exists fun equivalence :
          TypeEquivalence (context.GenericH1 family)
            (context.SpecialH1 family) =>
        context.CyclotomicLinear equivalence.toFun

/-- Erased Chow and cohomological realization vocabulary.  Cycles and classes
are indexed by codimension, so the specialization map cannot silently change
codimension. -/
structure ChowSpecializationContext where
  Family : Type
  GenericCycle : Family → Nat → Type
  SpecialCycle : Family → Nat → Type
  GenericClass : Family → Nat → Type
  SpecialClass : Family → Nat → Type
  IsProperFlatModel : Family → Prop
  genericCycleClass :
    {family : Family} → {codimension : Nat} →
      GenericCycle family codimension → GenericClass family codimension
  specialCycleClass :
    {family : Family} → {codimension : Nat} →
      SpecialCycle family codimension → SpecialClass family codimension
  specializeClass :
    {family : Family} → {codimension : Nat} →
      GenericClass family codimension → SpecialClass family codimension

/-- A specialization map on cycles together with the commuting cycle-class
square. -/
structure ChowSpecializationInput
    (context : ChowSpecializationContext) : Prop where
  specializeCycle :
    forall (family : context.Family), context.IsProperFlatModel family →
      forall (codimension : Nat)
        (cycle : context.GenericCycle family codimension),
        Exists fun specialized : context.SpecialCycle family codimension =>
          context.specialCycleClass specialized =
            context.specializeClass (context.genericCycleClass cycle)

/-! ## Weight-one realization and the final tensor-to-cohomology passage -/

/-- Erased vocabulary for the standard weight-one realization package.
`TensorCycleCombination` represents rational algebraic combinations realizing
tensor classes.  The alternating projection already lands in cohomological
degree/codimension `degree`; proving that the concrete projector has this type
is part of replacing the erasure. -/
structure WeightOneRealizationContext where
  AbelianVariety : Type
  RationalHomomorphism : AbelianVariety → AbelianVariety → Type
  H1Morphism : AbelianVariety → AbelianVariety → Type
  PoincareDivisor : AbelianVariety → AbelianVariety → Type
  TensorClass : AbelianVariety → Nat → Type
  CohomologyClass : AbelianVariety → Nat → Nat → Type
  TensorCycleCombination : AbelianVariety → Nat → Type
  CohomologyCycleCombination : AbelianVariety → Nat → Nat → Type
  IsHodgeTensor :
    {variety : AbelianVariety} → {power : Nat} →
      TensorClass variety power → Prop
  IsHodgeClass :
    {variety : AbelianVariety} → {power degree : Nat} →
      CohomologyClass variety power degree → Prop
  IsHodgeMorphism :
    {source target : AbelianVariety} → H1Morphism source target → Prop
  h1Realization :
    {source target : AbelianVariety} →
      RationalHomomorphism source target → H1Morphism source target
  poincareRealization :
    {source target : AbelianVariety} →
      PoincareDivisor source target → H1Morphism source target
  tensorCycleClass :
    {variety : AbelianVariety} → {power : Nat} →
      TensorCycleCombination variety power → TensorClass variety power
  cohomologyCycleClass :
    {variety : AbelianVariety} → {power degree : Nat} →
      CohomologyCycleCombination variety power degree →
        CohomologyClass variety power degree
  alternatingProject :
    {variety : AbelianVariety} → {power degree : Nat} →
      TensorClass variety power → CohomologyClass variety power degree
  projectCycle :
    {variety : AbelianVariety} → {power degree : Nat} →
      TensorCycleCombination variety power →
        CohomologyCycleCombination variety power degree

/-- The exact two statements needed to pass from algebraic tensor generators
to the rational Hodge conjecture on every power: Hodge classes lift to Hodge
tensors, and the alternating projector commutes with cycle realization. -/
structure WeightOneHodgeRealizationInput
    (context : WeightOneRealizationContext) : Prop where
  fullFaithfulH1 :
    forall (source target : context.AbelianVariety)
      (morphism : context.H1Morphism source target),
      context.IsHodgeMorphism morphism →
      Exists fun algebraic : context.RationalHomomorphism source target =>
        context.h1Realization algebraic = morphism
  poincareCorrespondence :
    forall (source target : context.AbelianVariety)
      (algebraic : context.RationalHomomorphism source target),
      Exists fun divisor : context.PoincareDivisor source target =>
        context.poincareRealization divisor =
          context.h1Realization algebraic
  hodgeClassLifts :
    forall (variety : context.AbelianVariety) (power degree : Nat)
      (hodgeClass : context.CohomologyClass variety power degree),
      context.IsHodgeClass hodgeClass →
      Exists fun tensor : context.TensorClass variety power =>
        context.IsHodgeTensor tensor ∧
        context.alternatingProject tensor = hodgeClass
  alternatingProjectorAlgebraic :
    forall (variety : context.AbelianVariety) (power degree : Nat)
      (cycle : context.TensorCycleCombination variety power),
      context.cohomologyCycleClass
          (context.projectCycle (degree := degree) cycle) =
        context.alternatingProject (degree := degree)
          (context.tensorCycleClass cycle)

/-! ## Bundle for the direct route -/

/-- The citation-level bundle expected by the direct all-powers route.
Contexts are explicit parameters, so this structure cannot hide an erased
geometric model.  It intentionally does not contain any Phase I block theorem,
zero-signature arithmetic, fusion construction, primitive-equals-whole step,
or determinant-specialization argument. -/
structure PublishedInputs
    (variation : VariationContext)
    {p : Nat} [NeZero p]
    (cyclicProjection : CyclicProjectionContext p)
    (normality : NormalityContext)
    (fft : StandardDualFFTContext)
    (acv : ACVSmoothingContext p)
    (schoen : SchoenContext p)
    (picard : CompactTypePicardContext)
    (comparison : SmoothProperComparisonContext)
    (chow : ChowSpecializationContext)
    (weightOne : WeightOneRealizationContext) where
  chevalleyWeil : ChevalleyWeilInput
  deligne : DeligneSemisimplicityFixedPartInput variation
  fullCyclicProjection : MenetNguyenFullProjectionInput cyclicProjection
  andre : AndreNormalityInput normality
  weyl : WeylStandardDualFFTInput fft
  aoki : AokiPrimeBalanceInput
  acvSmoothing : ACVBalancedSmoothingInput acv
  schoenSimpleTuple : SchoenSimpleTupleInput schoen
  compactTypePicard : CompactTypePicardInput picard
  smoothProperComparison : SmoothProperComparisonInput comparison
  chowSpecialization : ChowSpecializationInput chow
  weightOneRealization : WeightOneHodgeRealizationInput weightOne

end

end

end AbelianCoverHodge.External
